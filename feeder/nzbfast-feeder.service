[Unit]
Description=nzbfast feeder (indexer search -> nzbfast -> Radarr/Sonarr import)
After=network-online.target nzbfast.service docker.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/nzbfast-feeder/feeder.py -c /etc/nzbfast/feeder.json
Restart=always
RestartSec=30
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
