#!/bin/bash
# Example: pause / resume a production nzbfast's queue around benchmark runs (prod relays through this host
# and shares the provider accounts). Only resumes what this script paused.
# Set PROD_SSH (e.g. root@host) and PROD_API (e.g. http://127.0.0.1:8085) and PROD_KEY_CMD
# (a command run on that host that prints its API key).
STATE=/root/bench/.prod-paused-by-bench
api() {
  ssh -o BatchMode=yes "$PROD_SSH" "K=\$($PROD_KEY_CMD); curl -s \"$PROD_API/api?output=json&apikey=\$K&$1\""
}
case "$1" in
  pause)
    st=$(api "mode=queue&limit=0" | python3 -c 'import json,sys; print(json.load(sys.stdin)["queue"]["paused"])')
    if [ "$st" = "False" ] || [ "$st" = "false" ]; then
      api "mode=pause" > /dev/null && touch $STATE && echo "prod paused"
    else
      echo "prod already paused by someone else; leaving it"
    fi
    sleep 45 ;;  # let prod's idle provider sessions close (they count against account limits)
  resume)
    if [ -f $STATE ]; then api "mode=resume" > /dev/null && rm -f $STATE && echo "prod resumed"; fi ;;
  status)
    api "mode=queue&limit=0" | python3 -c 'import json,sys; q=json.load(sys.stdin)["queue"]; print("paused" if q["paused"] else "running", q["kbpersec"], "KB/s", q["noofslots_total"], "jobs")' ;;
esac
